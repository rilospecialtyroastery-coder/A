{% if section.settings.text != blank %}
<div class="announcement-bar">
  <p class="announcement-bar__message">{{ section.settings.text }}</p>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Free shipping on orders over AED 300" }
  ]
}
{% endschema %}
