<header class="site-header" id="SiteHeader">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="site-header__logo-img">
      {%- else -%}
        <span class="site-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      <a href="/" class="site-header__nav-link">Home</a>
      <a href="/collections/luxury-coffee-beans" class="site-header__nav-link">Shop</a>
      <a href="/collections/rilo-box" class="site-header__nav-link">Boxes</a>
      <a href="/pages/about" class="site-header__nav-link">About</a>
    </nav>
    <div class="site-header__icons">
      <a href="/search" class="site-header__icon" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="/cart" class="site-header__icon site-header__cart" aria-label="Cart">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" }
  ]
}
{% endschema %}
