{%- assign collection_obj = collections[section.settings.collection] -%}
{%- if collection_obj == blank -%}
  {%- assign collection_obj = collections['luxury-coffee-beans'] -%}
{%- endif -%}

<section class="featured-collection section-padding">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="product-grid">
      {%- for product in collection_obj.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>No products found.</p>
      {%- endfor -%}
    </div>
    <div class="featured-collection__footer">
      <a href="{{ collection_obj.url }}" class="btn btn--outline">View All</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "our coffees" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 4, "default": 12, "label": "Products to show" }
  ]
}
{% endschema %}
