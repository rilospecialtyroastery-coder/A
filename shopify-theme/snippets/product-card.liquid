<div class="product-card">
  <a href="{{ product.url }}" class="product-card__image-wrap">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}"
           alt="{{ product.featured_image.alt | escape }}"
           loading="lazy"
           class="product-card__image"
           width="600" height="600">
    {%- else -%}
      <div class="product-card__no-image"></div>
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge product-card__badge--sale">Sale</span>
    {%- elsif product.available == false -%}
      <span class="product-card__badge product-card__badge--sold-out">Sold Out</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <p class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="price--sale">{{ product.price | money }}</span>
        <span class="price--compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </p>
    {%- if product.available -%}
      <form action="/cart/add" method="post">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn--primary btn--full btn--sm">Add to Cart</button>
      </form>
    {%- else -%}
      <button class="btn btn--outline btn--full btn--sm" disabled>Sold Out</button>
    {%- endif -%}
  </div>
</div>
